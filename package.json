{
  "name": "agv-map-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:harness": "vite build --config tests/harness/vite.config.ts",
    "lint": "oxlint && node scripts/check-architecture.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test --project=browser",
    "test:perf": "playwright test --project=perf",
    "test:visual": "playwright test --project=visual",
    "check:arch": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@types/three": "0.185.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "oxlint": "1.76.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
